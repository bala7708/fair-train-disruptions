<http://localhost/dataset/5333c5cc-a7b4-4de4-b492-3b8de23fe64b> a dcat:Resource, dcat:Dataset;
  dcterms:title "Dutch train disruptions 2024 (FAIRified)";
  <http://www.w3.org/2000/01/rdf-schema#label> "Dutch train disruptions 2024 (FAIRified)";
  dcat:version "1.0";
  <https://w3id.org/fdp/fdp-o#metadataIssued> "2026-10-25T09:56:56.308859407Z"^^xsd:dateTime;
