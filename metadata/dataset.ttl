  dcterms:license <https://creativecommons.org/licenses/by/4.0/>;
  dcterms:description "All 5,964 train disruptions announced by NS in 2024, from Rijden de Treinen, converted to linked data (RDF). Each disruption has start and end time (with time zone), duration, affected stations and railway lines, and its cause in Dutch and English, linked to a cause group. Modelled with schema.org, SKOS and a mini-ontology (https://w3id.org/FAIR-course-UT/2026/group18/ont).";
  dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en>;
